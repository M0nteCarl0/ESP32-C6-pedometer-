# ==============================================================================
# Mercury Pedometer - Git Ignore Rules
# ==============================================================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Logs, Crash Dumps & Temp Files ---
*.log
*.tmp
*.bak
*.swp
*.swo
*~
crash-dumps/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.env
.venv
env/
venv/
ENV/

# --- IDEs & Editors ---
# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# CLion / CMake
cmake-build-*/

# --- Android / Gradle ---
.gradle/
**/.gradle/
build/
**/build/
local.properties
**/local.properties
.cxx/
**/.cxx/
captures/
**/captures/

# Built APKs, App Bundles and Dex
*.apk
*.ap_
*.aab
*.dex
*.class

# Keystore & Signing
*.jks
*.keystore

# --- ESP32 / PlatformIO / Embedded ---
esp32_firmware/.pio/
esp32_firmware/.pioenvs/
esp32_firmware/.piolibdeps/
esp32_firmware/.clangd/

# Compiled firmware binaries & object files
*.bin
*.elf
*.hex
*.map
*.o
*.d
*.a

# Arduino IDE temp build dirs
*.arduino.hex
*.arduino.elf
