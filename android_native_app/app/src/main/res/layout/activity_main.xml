<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title & BLE Status -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32-C6 Pedometer Sync"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="#EF4444"
            android:layout_marginTop="2dp"
            android:textSize="13sp" />

        <!-- Connect Button -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Scan &amp; Connect"
            android:backgroundTint="#00FFA3"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <!-- Big Steps Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#162235"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S STEPS"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#00FFA3"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE: PAUSED"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Metrics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#131B2A"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIST"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"/>
                <TextView
                    android:id="@+id/tvDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 km"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#131B2A"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KCAL"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"/>
                <TextView
                    android:id="@+id/tvKcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kcal"
                    android:textColor="#FF7A00"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#131B2A"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CADENCE"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"/>
                <TextView
                    android:id="@+id/tvCadence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 spm"
                    android:textColor="#A855F7"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#131B2A"
                android:padding="8dp"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"/>
                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 km/h"
                    android:textColor="#22C55E"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- TARGET SETTINGS (STEPS & DURATION) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#162235"
            android:padding="12dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 ЦЕЛИ: ШАГИ И ВРЕМЯ В ДВИЖЕНИИ"
                android:textColor="#00FFA3"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Steps Goal Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Шаги:"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etTargetSteps"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#0A0E17"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:text="10000"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <Button
                    android:id="@+id/btnQuick5k"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="5K"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="4dp" />

                <Button
                    android:id="@+id/btnQuick10k"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="10K"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="2dp" />

                <Button
                    android:id="@+id/btnQuick15k"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="15K"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- Duration Goal Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Время:"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/etTargetDurationMin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#0A0E17"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:text="30"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="мин"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQuick15m"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="15м"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="2dp" />

                <Button
                    android:id="@+id/btnQuick30m"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="30м"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="2dp" />

                <Button
                    android:id="@+id/btnQuick60m"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="60м"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- Buttons: Set Targets & Reset Targets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnSetTargets"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.3"
                    android:text="Установить цели"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnClearTargets"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.7"
                    android:text="Сбросить"
                    android:backgroundTint="#374151"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Live Target Progress & Remaining Time -->
            <TextView
                android:id="@+id/tvTargetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цели: 10,000 шагов | 30 мин движения"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />

            <ProgressBar
                android:id="@+id/pbStepsTarget"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progress="0"
                android:max="100"
                android:progressTint="#00FFA3"
                android:progressBackgroundTint="#1E293B"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- GOOGLE MAPS & GPS EMULATION SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#162235"
            android:padding="12dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️ GOOGLE MAPS: МАРШРУТ И ЭМУЛЯЦИЯ GPS"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRouteInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Кликните на карту для добавления точек маршрута"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <!-- Route Actions Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnPresetRoutes"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Пресеты"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnSaveRoute"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Сохранить"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnLoadRoute"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Загрузить"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Embedded Interactive Map View (WebView) -->
            <WebView
                android:id="@+id/webViewMap"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#0A0E17"
                android:layout_marginTop="8dp" />

            <!-- GPS Emulation Toggle Button -->
            <Button
                android:id="@+id/btnToggleGps"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="▶ Запустить GPS Эмуляцию"
                android:backgroundTint="#22C55E"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <!-- GPS Status -->
            <TextView
                android:id="@+id/tvGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS: Не активен (требуется фиктивное местоположение)"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnOpenDevSettings"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="⚙ Выбрать приложение для фиктивных локаций"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- GOOGLE FIT & HEALTH CONNECT SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOOGLE FIT / HEALTH CONNECT SYNC"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History status: not synced"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <!-- Main Upload Button -->
        <Button
            android:id="@+id/btnUploadGoogleFit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Upload Steps to Google Fit"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnSyncHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sync History"
                android:backgroundTint="#1E293B"
                android:textColor="#E2E8F0"
                android:layout_marginEnd="4dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnExportJson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share JSON"
                android:backgroundTint="#1E293B"
                android:textColor="#E2E8F0"
                android:layout_marginStart="4dp"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ESP32 Hardware Controls -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP32 CONTROLS"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:weightSum="4">

            <Button
                android:id="@+id/btnWalk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Walk"
                android:backgroundTint="#166534"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnJog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jog"
                android:backgroundTint="#854D0E"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pause"
                android:backgroundTint="#374151"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnAdd1000"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+1000"
                android:backgroundTint="#0369A1"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Live Event Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EVENT LOG"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvConsoleLog"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#05070A"
            android:padding="8dp"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:layout_marginTop="4dp"
            android:text="Ready." />

    </LinearLayout>
</ScrollView>
